@using MiniShop.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject CartService CartService
@rendermode InteractiveServer

@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 shadow-sm">
    <a class="navbar-brand" href="/">MiniShop</a>

    <ul class="navbar-nav ms-auto">

        <li class="nav-item">
            <NavLink class="nav-link" href="/products">Products</NavLink>
        </li>

        <li class="nav-item">
            <NavLink class="nav-link" href="/cart">Cart</NavLink>
            @if (cartItemCount > 0)
            {
                <span class="cart-badge">
                    @cartItemCount
                </span>
            }
        </li>

        @if (Auth.CurrentUser == null)
        {
            <li class="nav-item">
                <NavLink class="nav-link" href="/login">Login</NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/register">Register</NavLink>
            </li>
        }
        else
        {
            <li class="nav-item d-flex align-items-center text-white me-2 ml-20px">
                Welcome, @Auth.CurrentUser.Email.Split('@')[0]
            </li>

            <li class="nav-item align-content-center">
                <button class="btn btn-sm btn-outline-light" @onclick="Logout">
                    Logout
                </button>
            </li>
        }
    </ul>
</nav>


@code {
    private int cartItemCount;

    /*
     * Subscribes to auth and cart state changes and loads initial cart data.
     */
    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += OnAnyChange;
        CartService.OnChange += OnAnyChange;

        await RefreshCart();
    }

    /*
     * Triggers a cart refresh when authentication or cart state changes.
     */
    private void OnAnyChange()
    {
        _ = RefreshCart(); 
    }

    /*
     * Updates the cart item count based on the current user and refreshes the UI.
     */
    private async Task RefreshCart()
    {
        if (Auth.CurrentUser != null)
        {
            cartItemCount = await CartService.GetCartItemCountAsync();
        }
        else
        {
            cartItemCount = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    /*
     * Logs out the current user and redirects to the home page.
     */
    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    /*
     * Unsubscribes from auth and cart events to prevent memory leaks.
     */
    public void Dispose()
    {
        Auth.OnChange -= OnAnyChange;
        CartService.OnChange -= OnAnyChange;
    }

}

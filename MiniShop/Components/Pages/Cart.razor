@page "/cart"
@rendermode InteractiveServer
@using MiniShop.Services
@using MiniShop.Models
@inject CartService CartService
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable


<h2 class="cart-title">Your Cart</h2>

@if (AuthService.CurrentUser == null)
{
    <div class="cart-empty">You must be logged in.</div>
}
else if (cart == null || !cart.Items.Any())
{
    <div class="cart-empty">Your cart is empty.</div>
}
else
{
    <div class="cart-container">

        <div class="cart-items">
            @foreach (var item in cart.Items)
            {
                <div class="cart-item">

                    <img src="@item.Product.ImageUrl"
                         alt="@item.Product.Name"
                         class="cart-image" />

                    <div class="cart-details">
                        <h5>@item.Product.Name</h5>
                        <p class="cart-price">$@item.Price.ToString("F2")</p>

                        <div class="cart-quantity">
                            <span>Quantity: @item.Quantity</span>
                        </div>
                    </div>

                    <div class="cart-subtotal">
                        $@(item.Price* item.Quantity)
                    </div>

                </div>
            }
        </div>

        @if (checkoutMessage != null)
        {
            <div class="checkout-message">@checkoutMessage</div>
        }
        <div class="cart-summary">
            <h4>Order Summary</h4>
            <div class="summary-row">
                <span>Total:</span>
                <span class="summary-total">$@cart.Total.ToString("F2")</span>
            </div>

            <button class="checkout-btn" @onclick="Checkout">
                Proceed to Checkout
            </button>

        </div>

    </div>
}

@code {
    private Order? cart;
    private string? checkoutMessage;

    /*
     * Subscribes to authentication changes and loads the cart
     * if a user is already authenticated.
     */
    protected override async Task OnInitializedAsync()
    {
        AuthService.OnChange += AuthChanged;

        if (AuthService.CurrentUser != null)
        {
            cart = await CartService.GetCartAsync();
        }
    }

    /*
     * Updates the cart when authentication state changes
     * and refreshes the UI accordingly.
     */
    private async void AuthChanged()
    {
        if (AuthService.CurrentUser != null)
        {
            cart = await CartService.GetCartAsync();
        }
        else
        {
            cart = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    /*
     * Unsubscribes from authentication state changes to prevent memory leaks.
     */
    public void Dispose()
    {
        AuthService.OnChange -= AuthChanged;
    }

    /*
     * Finalizes the current cart order and redirects to the success page
     * if the checkout process completes successfully.
     */
    private async Task Checkout()
    {
        if (cart == null || !cart.Items.Any())
            return;

        var success = await CartService.CheckoutAsync();

        if (success)
        {
            Nav.NavigateTo("/order-success");
        }
        else
        {
            checkoutMessage = "Checkout failed.";
            StateHasChanged();
        }
    }

}

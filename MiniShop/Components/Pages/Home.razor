@page "/"
@using MiniShop.Services
@inject AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer

@implements IDisposable



<div class="container mt-5 text-center">

    <h1 class="mb-4">Welcome to MiniShop</h1>
    <p>Your favorite online store built with Blazor.</p>

    @if (Auth.CurrentUser == null)
    {
        <div class="mt-4">
            <button class="btn btn-primary me-3"
                    @onclick="@(() => Nav.NavigateTo("/login"))">
                Login
            </button>

            <button class="btn btn-outline-primary"
                    @onclick="@(() => Nav.NavigateTo("/register"))">
                Register
            </button>
        </div>
    }
    else
    {
        <div class="mt-4">
            <h4>Welcome back, @Auth.CurrentUser.Email.Split('@')[0]!</h4>

            <button class="btn btn-success mt-3"
                    @onclick="@(() => Nav.NavigateTo("/products"))">
                Start Shopping
            </button>
        </div>
    }

</div>

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += AuthChanged;
    }

    private void AuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.OnChange -= AuthChanged;
    }
}